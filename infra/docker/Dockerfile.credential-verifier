# syntax=docker/dockerfile:1

# Build from the monorepo root:
#   docker build -f infra/docker/Dockerfile.credential-verifier -t hirekiwi-credential-verifier .

FROM node:22.20.0-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

WORKDIR /app

# ---------------------------------------------------------
# Dependencies
# ---------------------------------------------------------
FROM base AS deps

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./

# Required by root package.json preinstall hook.
COPY scripts ./scripts

# Copy workspace manifests first so dependency installation
# remains cached when source files change.
COPY packages/*/package.json ./packages/
COPY apps/*/package.json ./apps/

COPY apps/credential-verifier/prisma ./apps/credential-verifier/prisma
COPY apps/credential-verifier/prisma.config.ts ./apps/credential-verifier/prisma.config.ts

RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------
# Build
# ---------------------------------------------------------
FROM deps AS build

COPY packages ./packages
COPY apps ./apps

ENV DATABASE_URL=postgresql://hirekiwi:hirekiwi@127.0.0.1:5432/credential_verifier

RUN pnpm --filter @hirekiwi/credential-verifier... build

# ---------------------------------------------------------
# Runtime
# ---------------------------------------------------------
FROM node:22.20.0-bookworm-slim AS runner

ENV NODE_ENV=production

WORKDIR /app

RUN useradd --system --uid 10001 credverify

COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/dist \
    ./apps/credential-verifier/dist

COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/package.json \
    ./apps/credential-verifier/package.json

COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/prisma \
    ./apps/credential-verifier/prisma

COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/prisma.config.ts \
    ./apps/credential-verifier/prisma.config.ts

COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/src/generated \
    ./apps/credential-verifier/src/generated

# tsc (rootDir=src, outDir=dist) doesn't compile the pre-built
# Prisma client into dist. Mirror generated Prisma client into
# dist/generated because compiled JS references it there.
COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/src/generated \
    ./apps/credential-verifier/dist/generated

COPY --from=build --chown=credverify:credverify \
    /app/apps/credential-verifier/node_modules \
    ./apps/credential-verifier/node_modules

COPY --from=build --chown=credverify:credverify \
    /app/node_modules \
    ./node_modules

COPY --from=build --chown=credverify:credverify \
    /app/packages \
    ./packages

COPY --from=build --chown=credverify:credverify \
    /app/pnpm-workspace.yaml \
    ./pnpm-workspace.yaml

COPY --from=build --chown=credverify:credverify \
    /app/package.json \
    ./package.json

USER credverify

EXPOSE 3100

HEALTHCHECK \
    --interval=20s \
    --timeout=5s \
    --start-period=20s \
    CMD node -e "fetch('http://127.0.0.1:3100/api/docs-json').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /app/apps/credential-verifier

CMD ["node", "dist/main.js"]
