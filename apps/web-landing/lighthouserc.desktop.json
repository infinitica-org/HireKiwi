{
  "ci": {
    "collect": {
      "startServerCommand": "next start --port 3007",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3007/",
        "http://localhost:3007/students",
        "http://localhost:3007/universities",
        "http://localhost:3007/company",
        "http://localhost:3007/universities/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox",
        "blockedUrlPatterns": ["*cdn-cookieyes.com*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "color-contrast": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "image-alt": "error",
        "label": "error",
        "link-name": "error",
        "button-name": "error",
        "heading-order": "error",
        "meta-description": "error",
        "is-crawlable": "error",
        "canonical": "error",
        "errors-in-console": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
