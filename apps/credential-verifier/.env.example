NODE_ENV=development
HOST=0.0.0.0
PORT=3100
APP_NAME=credential-verifier
APP_VERSION=0.1.0

# Same shared Postgres as api-core (infra/docker/docker-compose.yml); own database on that instance.
DATABASE_URL=postgresql://smart:smart@127.0.0.1:5432/credential_verifier?schema=public
REDIS_URL=redis://127.0.0.1:6380

CORS_ORIGINS=http://localhost:3004,http://localhost

VERIFICATION_CACHE_TTL_SECONDS=21600
VERIFICATION_RATE_LIMIT_PER_HOUR=30
