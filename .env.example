# HireKiwi local / VPS environment
# Copy to `.env` (laptop) or `.env.dev` / `.env.qa` / `.env.prod` on a VPS.
# Never commit filled env files. See docs/delivery/DATABASE.md

HIREKIWI_ENV=local
COMPOSE_PROJECT_NAME=hirekiwi-local
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# --- data plane (migrations/CLI always use DATABASE_URL) ---
# Local Docker Postgres. Do not share one project across local/dev/qa/prod.
DATABASE_URL=postgresql://hirekiwi:hirekiwi@127.0.0.1:5432/hirekiwi?schema=public
# Runtime app pool goes through PgBouncer (transaction pooling) instead of
# straight to postgres. Optional — falls back to DATABASE_URL when unset,
# e.g. this laptop-outside-Docker `pnpm dev:api` flow. See DATABASE.md.
POOLED_DATABASE_URL=postgresql://hirekiwi:hirekiwi@127.0.0.1:6432/hirekiwi?schema=public
POSTGRES_PASSWORD=hirekiwi
REDIS_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:19092

# --- auth (MUST be >= 32 chars) ---
JWT_SECRET=local-dev-jwt-secret-change-me-now!!
METRICS_SCRAPE_TOKEN=

# --- browser origins (comma-separated, no spaces) ---
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost

# --- 10 Apps Port & Local URL Bindings ---
PORT=3000
STUDENT_PORT=3001
TPO_PORT=3002
ADMIN_PORT=3003
VERIFY_PORT=3004
AUTH_PORT=3005
COMPANY_PORT=3006
LANDING_PORT=3007
DOCS_PORT=3008
PROCTORING_CV_PORT=8091

API_APP_URL=http://localhost:3000
STUDENT_APP_URL=http://localhost:3001
TPO_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003
VERIFY_APP_URL=http://localhost:3004
AUTH_APP_URL=http://localhost:3005
COMPANY_APP_URL=http://localhost:3006
LANDING_APP_URL=http://localhost:3007
DOCS_APP_URL=http://localhost:3008

# Public URL the Next.js apps call. On a VPS this is https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3005

# --- object storage (MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-reachable URL for presigned audio uploads (defaults to S3_ENDPOINT).
# Docker API: set to http://127.0.0.1:9000 while S3_ENDPOINT=http://minio:9000.
# VPS/prod: set to your public R2/MinIO URL (must match MINIO_API_CORS_ALLOW_ORIGIN).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=hirekiwi
S3_ACCESS_KEY=hirekiwi
S3_SECRET_KEY=hirekiwisecret
MINIO_ROOT_USER=hirekiwi
MINIO_ROOT_PASSWORD=hirekiwisecret
# Community MinIO global CORS (comma-separated origins for browser audio PUT uploads).
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,https://dev.app.hirekiwi.online

# --- AI (Anthropic primary, Google GenAI & OpenRouter fallback — validated at boot) ---
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
AI_MONTHLY_CEILING_USD=500

# --- Certificate cryptographic signing (Sprint 6 — S6-VB-04) ---
# HMAC-SHA256 secret used to sign certificate canonical payloads.
# Must be >= 32 chars. Rotate per the key-management runbook.
# Never share between environments. See ADR-0016.
CERTIFICATE_HMAC_SECRET=local-dev-cert-hmac-secret-change-me!!

# --- Project defense speech ---
# browser = Web Speech + speechSynthesis (SPEECH_STT_PROVIDER=stub — env name, not a code stub).
# whisper = optional OpenAI Whisper API when OPENAI_API_KEY is set.
# Future: local = self-hosted faster-whisper sidecar for cert-grade server STT without API fees.
SPEECH_STT_PROVIDER=stub
SPEECH_TTS_PROVIDER=stub
OPENAI_API_KEY=
SPEECH_WHISPER_MODEL=whisper-1
PROCTORING_FULL=true
# web-student: must stay aligned with PROCTORING_FULL (false here skips UI onboarding while API still enforces proctoring)
NEXT_PUBLIC_PROCTORING_FULL=true
# Host dev: http://127.0.0.1:8091 — Docker API: http://proctoring-cv:8091
PROCTORING_CV_URL=http://127.0.0.1:8091
PROCTORING_CV_PORT=8091
# stub = no CV (CI default); real = YuNet + head pose + unified YOLO object detect
PROCTORING_CV_PROVIDER=stub
# Sidecar only (when PROCTORING_CV_PROVIDER=real): min YOLO confidence for FOREIGN_OBJECT_DETECTED
# PROCTORING_OBJECT_CONF=0.45

# --- CN-T01 onboarding: GitHub repo picker + LinkedIn identity verification ---
# Public-data-only PAT (no scopes) — raises the GitHub REST rate limit from
# 60/hr per IP to 5,000/hr. Required before this sees real traffic.
GITHUB_API_TOKEN=
# LinkedIn OIDC app ("Sign in with LinkedIn") — verification only, never scrapes profiles.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/v1/users/onboarding/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/users/onboarding/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- VPS hostnames (Caddy). Use real DNS records pointing at the VPS. ---
API_HOST=api.localhost
STUDENT_HOST=app.localhost
TPO_HOST=tpo.localhost
ADMIN_HOST=admin.localhost
VERIFY_HOST=verify.localhost
AUTH_HOST=auth.localhost
COMPANY_HOST=company.localhost
LANDING_HOST=landing.localhost
DOCS_HOST=docs.localhost
STUDIO_HOST=studio.localhost
DB_HOST=db.localhost
DB_BASIC_AUTH_USER=admin
DB_BASIC_AUTH_HASH=

GRAFANA_PASSWORD=hirekiwi
LOG_LEVEL=info
LOG_PRETTY=true

# --- obs profile: Tempo (tracing) ---
TEMPO_PORT=3103
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# --- api-core: QLIX project integrity (Phase 1 — omit QLIX_API_KEY for stub mode) ---
QLIX_API_KEY=
QLIX_BASE_URL=https://qlix.exora.solutions/api/v1
QLIX_POLL_INTERVAL_MS=10000
QLIX_POLL_HARD_CAP_MS=1800000
QLIX_SIMILARITY_HARD_FAIL=50
QLIX_SIMILARITY_BORDERLINE=30
QLIX_AI_LIKELIHOOD_FLAG=60

# --- api-core: OpenTelemetry (opt-in — unset = no tracing, no overhead) ---
# Set to http://tempo:4318 to export traces once the obs profile is up.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1

# --- Backups (S6-VV-97; see docs/delivery/BACKUP_RESTORE.md) ---
# Nightly encrypted Postgres + MinIO backup to an S3-compatible bucket at a
# DIFFERENT provider than this VPS. Idle until BACKUP_ENABLED=true.
# Local stacks normally leave this off.
BACKUP_ENABLED=false
BACKUP_ENV_NAME=local
# Cron in UTC. Default 20:30 UTC = 02:00 IST.
BACKUP_SCHEDULE="30 20 * * *"
# age PUBLIC key only (age1...). The private key stays offline with the key holders.
BACKUP_AGE_RECIPIENT=
# rclone destination: "offsite:<bucket>[/prefix]". The offsite remote is configured by BACKUP_S3_*.
BACKUP_DEST=offsite:CHANGE_ME
BACKUP_INCLUDE_OBJECTS=true
# rclone s3 provider name: AWS, Cloudflare, Wasabi, Other (Backblaze B2 S3 API = Other)...
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# S6-VV-119: object storage encryption at rest. Generate the key with
#   echo "hirekiwi-key:$(openssl rand -base64 32)"
# and store it with the backup age key (docs/delivery/STORAGE_ENCRYPTION.md). Losing it makes
# every encrypted object unreadable. Set S3_ENCRYPTION=required only after the bucket encrypts.
MINIO_KMS_SECRET_KEY=
S3_ENCRYPTION=off

# S6-VV-120: scan uploads with ClamAV. Start it with `--profile scan`, then set required.
# With required, an upload is refused if clamd is unreachable (fails closed).
FILE_SCAN=off

# S6-VV-118: the daily retention sweep only reports counts until this is false.
RETENTION_DRY_RUN=true

# S6-VV-125 — Grafana alert delivery (decision D3). Webhook: Slack/Zoho Cliq incoming URL.
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=
