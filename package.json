{
  "name": "hirekiwi-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HireKiwi — Intelligent Talent Discovery & Evidence-Backed Readiness Platform (Turborepo monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@hirekiwi/api-core",
    "dev:web": "turbo run dev --filter=@hirekiwi/web-*",
    "dev:student": "turbo run dev --filter=@hirekiwi/web-student",
    "dev:tpo": "turbo run dev --filter=@hirekiwi/web-tpo",
    "dev:admin": "turbo run dev --filter=@hirekiwi/web-admin",
    "dev:verify": "turbo run dev --filter=@hirekiwi/web-verify",
    "dev:auth": "turbo run dev --filter=@hirekiwi/web-auth",
    "dev:company": "turbo run dev --filter=@hirekiwi/web-company",
    "dev:landing": "turbo run dev --filter=@hirekiwi/web-landing",
    "dev:docs": "turbo run dev --filter=@hirekiwi/web-docs",
    "dev:cv": "python apps/proctoring-cv/server.py",
    "dev:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "ports": "node -e \"console.log('\\n=== HireKiwi (10 Apps) Single Linux VPS Port Mapping ===\\n  # App Name          Prod Blue   Prod Green  Dev VPS     Local Host\\n  1. api-core         :3000       :3010       :3020       http://localhost:3000\\n  2. web-student      :3001       :3011       :3021       http://localhost:3001\\n  3. web-tpo          :3002       :3012       :3022       http://localhost:3002\\n  4. web-admin        :3003       :3013       :3023       http://localhost:3003\\n  5. web-verify       :3004       :3014       :3024       http://localhost:3004\\n  6. web-auth         :3005       :3015       :3025       http://localhost:3005\\n  7. web-company      :3006       :3016       :3026       http://localhost:3006\\n  8. web-landing      :3007       :3017       :3027       http://localhost:3007\\n  9. web-docs         :3008       :3018       :3028       http://localhost:3008\\n 10. proctoring-cv    :8091       :8092       :8093       http://localhost:8091\\n\\n  [Data Plane]        PostgreSQL: 127.0.0.1:5432 | PgBouncer: 127.0.0.1:6432\\n                      Redis: 127.0.0.1:6379/6380 | Kafka: 127.0.0.1:19092\\n                      MinIO: 127.0.0.1:9000 (Console: 9001)\\n===========================================================\\n')\"",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!@hirekiwi/e2e --filter=!@hirekiwi/load-tests",
    "test:watch": "turbo run test:watch",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "infra:up": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:obs": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml --profile obs up -d",
    "infra:apps": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml --profile apps up -d --build",
    "infra:vps": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml --profile apps --profile vps --profile obs up -d --build",
    "infra:down": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml --profile apps --profile vps --profile obs down",
    "infra:reset": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml down -v",
    "infra:logs": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml logs -f",
    "infra:ps": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml ps",
    "db:generate": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core db:generate",
    "db:migrate": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core db:migrate",
    "db:deploy": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core db:deploy",
    "db:reset": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core db:reset",
    "db:studio": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core db:studio",
    "db:seed": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core db:seed",
    "db:diff": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/api-core prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma",
    "db:verify": "node scripts/verify-db-migrations.mjs",
    "cv:db:generate": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/credential-verifier db:generate",
    "cv:db:deploy": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/credential-verifier db:deploy",
    "cv:db:seed": "node ./scripts/ensure-pnpm.mjs pnpm --filter @hirekiwi/credential-verifier db:seed",
    "content": "pnpm --filter @hirekiwi/content-pipeline start",
    "e2e": "pnpm --filter @hirekiwi/e2e test",
    "load": "pnpm --filter @hirekiwi/load-tests test",
    "stress:up": "node ./scripts/ensure-pnpm.mjs docker compose -f infra/docker/docker-compose.yml --profile apps --profile obs up -d --build",
    "stress:seed": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/seed-test-data.sh",
    "stress:wait": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/wait-for-services.sh",
    "stress:smoke": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/tests/smoke.js",
    "stress:baseline": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/tests/baseline.js",
    "stress:load": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/tests/load.js",
    "stress:stress": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/tests/stress.js",
    "stress:spike": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/tests/spike.js",
    "stress:soak": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/tests/soak.js",
    "stress:browser": "node ./scripts/ensure-pnpm.mjs bash ./tools/load-tests/scripts/run-k6.sh src/scenarios/browser-student-flow.js",
    "stress:dashboard": "node -e \"console.log('Grafana:    http://localhost:' + (process.env.GRAFANA_PORT || 3100)); console.log('Prometheus: http://localhost:' + (process.env.PROMETHEUS_PORT || 9090));\"",
    "bootstrap": "node ./scripts/ensure-pnpm.mjs bash ./scripts/bootstrap.sh",
    "doctor": "node ./scripts/ensure-pnpm.mjs bash ./scripts/doctor.sh",
    "verify:handover": "node ./scripts/ensure-pnpm.mjs bash ./scripts/verify-handover.sh",
    "preinstall": "node ./scripts/ensure-pnpm.mjs --strict",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@hirekiwi/eslint-config": "workspace:*",
    "@hirekiwi/tsconfig": "workspace:*",
    "@types/node": "26.2.0",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "tools/content-pipeline/data/**/*.json": [
      "pnpm --filter @hirekiwi/content-pipeline validate:staged"
    ],
    "package.json": [
      "node scripts/check-lockfile.mjs"
    ],
    "**/package.json": [
      "node scripts/check-lockfile.mjs"
    ],
    "pnpm-lock.yaml": [
      "node scripts/check-lockfile.mjs"
    ]
  }
}
